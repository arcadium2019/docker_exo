# crane (en conteneur). DOCKER_CONFIG dédié ne contenant QUE le compte ci (on ne monte pas ~/.docker/config.json et tous ses identifiants)
$ alias crane="docker run --rm --network host -v ./registry/trust/ca.crt:/ca.crt:ro,Z -e SSL_CERT_FILE=/ca.crt -v ./.tools-docker:/docker:ro,Z -e DOCKER_CONFIG=/docker gcr.io/go-containerregistry/crane:v0.22.1"
$ crane tag localhost:5000/shopapi:1.4.2 1
2026/10/26 10:10:02 localhost:5000/shopapi:1: digest: sha256:0e322832db317fd07e57b36aef41cf23d5f13cae1611bdc0f659ca434add9756 size: 1991

$ for t in 1.4.2 1.4 1; do crane digest localhost:5000/shopapi:$t; done
