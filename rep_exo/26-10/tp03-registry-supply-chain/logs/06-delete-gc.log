# Préparation : busybox poussé en demo-gc:a, puis retag côté registre (GET manifest + PUT) en demo-gc:b
$ MT=$("${CURL[@]}" -u ci:... -I -H "Accept: $ACCEPT" $REG/v2/demo-gc/manifests/a | awk -F": " "tolower(\$1)==\"content-type\"{print \$2}")
MT=application/vnd.docker.distribution.manifest.v2+json
$ "${CURL[@]}" -u ci:... -H "Accept: $MT" $REG/v2/demo-gc/manifests/a -o m.json
$ "${CURL[@]}" -u ci:... -X PUT -H "Content-Type: $MT" --data-binary @m.json $REG/v2/demo-gc/manifests/b
201
$ tags + digests
{"name":"demo-gc","tags":["a","b"]}
a -> Docker-Content-Digest: sha256:63bb1322b9692d0a4ba0084a8168277d767a73048fc79a4869b912fe32d26bee
b -> Docker-Content-Digest: sha256:63bb1322b9692d0a4ba0084a8168277d767a73048fc79a4869b912fe32d26bee

$ docker compose exec registry du -sh /var/lib/registry/docker/registry/v2/blobs   # avant
97.4M	/var/lib/registry/docker/registry/v2/blobs

# Un tag ne peut pas être supprimé par son nom :
$ "${CURL[@]}" -u ci:... -X DELETE $REG/v2/demo-gc/manifests/a
{"errors":[{"code":"DIGEST_INVALID","message":"provided digest did not match uploaded content"}]}
 -> 400
# dev ne peut pas supprimer :
{"errors":[{"code":"DENIED","message":"push requires the ci account"}]} -> 403
$ "${CURL[@]}" -u ci:... -X DELETE $REG/v2/demo-gc/manifests/sha256:63bb1322b9692d0a4ba0084a8168277d767a73048fc79a4869b912fe32d26bee
202
$ "${CURL[@]}" -u ci:... $REG/v2/demo-gc/tags/list
{"name":"demo-gc","tags":null}


$ docker compose exec registry registry garbage-collect --delete-untagged /etc/docker/registry/config.yml
