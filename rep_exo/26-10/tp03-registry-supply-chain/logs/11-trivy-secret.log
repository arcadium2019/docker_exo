$ trivy image --scanners secret --input .scan/shopapi_legacy.tar -f json | jq   # (équivalent de trivy image --scanners secret shopapi:legacy, via docker save)
CRITICAL	aws-access-key-id	/app/.env:4	AWS_SECRET_ACCESS_KEY=********************	(layer: COPY . /app # buildkit)

$ trivy image --scanners secret --input .scan/shopapi_1.4.2.tar -f json | jq "[.Results[]?.Secrets[]?] | length"
0

# Le mot de passe de ENV DATABASE_URL est dans la CONFIG de l image, pas dans une couche : il faut le scanner de config
$ trivy image --scanners secret --image-config-scanners secret --input .scan/shopapi_legacy.tar -f json | jq …
CRITICAL	aws-access-key-id	/app/.env	AWS_SECRET_ACCESS_KEY=********************

# Règle personnalisée trivy-secret.yaml (URL de connexion avec mot de passe, hors node_modules / cache npm)
$ trivy image --scanners secret --image-config-scanners secret --secret-config trivy-secret.yaml --input .scan/shopapi_legacy.tar -f json | jq …
CRITICAL	aws-access-key-id	/app/.env	AWS_SECRET_ACCESS_KEY=********************
CRITICAL	connection-string-password	/app/.env	DATABASE_URL=postgres://shop:*******@localhost:5432/shop
CRITICAL	connection-string-password	/app/Dockerfile	ENV DATABASE_URL=postgres://shop:*******@db.internal:5432/shop
