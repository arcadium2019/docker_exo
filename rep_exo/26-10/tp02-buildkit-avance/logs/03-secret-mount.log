$ docker build --secret id=pipconf,src=pip.conf --build-arg VERSION=1.0 --build-arg GIT_SHA=068ba9e -t worker:1.0 .
#8 [test 3/5] COPY worker ./worker
#9 [users 1/1] RUN groupadd --system --gid 10001 worker     && useradd --system --uid 10001 --gid worker --no-create-home --shell /usr/sbin/nologin worker
#10 [test 2/5] RUN pip install -r requirements-dev.txt
#11 [runtime 4/5] COPY --from=builder /opt/venv /opt/venv
#13 [test 1/5] COPY requirements.txt requirements-dev.txt ./
#14 [builder 2/3] COPY requirements.txt .
#15 [runtime 3/5] COPY --from=users /etc/passwd /etc/group /etc/
#16 [test 4/5] COPY tests ./tests
#17 [builder 3/3] RUN case "amd64" in       amd64) arch=x86_64 ;;       arm64) arch=aarch64 ;;       *) echo "unsupported TARGETARCH=amd64" >&2; exit 1 ;;     e
#18 [builder 1/3] RUN python -m venv --without-pip /opt/venv
#19 [test 5/5] RUN ruff check --no-cache worker tests && python -m pytest -q -p no:cacheprovider && touch /tmp/.tests-passed
#20 [runtime 5/5] COPY worker ./worker
#21 naming to docker.io/library/worker:1.0 done

$ docker history --no-trunc worker:1.0 | grep -i -E "Tr3s|pypi|pip.conf|secret|index"
(rien)

# L'historique de l'image finale ne contient que les instructions du stage runtime : les RUN qui montent
# le secret sont dans des stages intermédiaires (builder, test), jamais exportés dans l'image.

$ docker run --rm worker:1.0 cat /etc/pip.conf
cat: /etc/pip.conf: No such file or directory
exit=1
$ docker run --rm worker:1.0 ls -la /app
total 0
drwxr-xr-x. 1 root root 12 Oct 26 10:41 .
drwxr-xr-x. 1 root root  0 Oct 26 10:59 ..
drwxr-xr-x. 1 root root 36 Oct 26 09:50 worker
$ docker run --rm worker:1.0 sh -c "id; python -m pip list | grep -iE \"pytest|ruff\" || echo no dev deps"
uid=10001(worker) gid=10001(worker) groups=10001(worker)
no dev deps

