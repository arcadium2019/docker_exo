# syntax=docker/dockerfile:1.10
# shop-worker - bonus B3: same stages as Dockerfile, uv instead of pip.
# The index URL (with credentials) is a secret exposed as an environment variable of the RUN only.
ARG PYTHON_IMAGE=python:3.12.15-slim-trixie
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.5

# uv runs in build stages: take the binary for the BUILD platform, not the target one.
FROM --platform=$BUILDPLATFORM ${UV_IMAGE} AS uv

FROM --platform=$BUILDPLATFORM ${PYTHON_IMAGE} AS build-base
COPY --from=uv /uv /usr/local/bin/uv
# The cache mount lives on another filesystem: copy instead of hardlinking (silences uv's warning).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0
WORKDIR /app

FROM build-base AS builder
ARG TARGETARCH
# Bonus B1: --build-arg UV_OFFLINE=true + --network=none installs from the cache mount only.
ARG UV_OFFLINE=false
RUN python -m venv --without-pip /opt/venv
COPY requirements.txt .
RUN --mount=type=secret,id=index_url,env=UV_DEFAULT_INDEX \
    --mount=type=cache,id=uv-${TARGETARCH},target=/root/.cache/uv,sharing=locked \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && uv pip install --target /opt/venv/lib/python3.12/site-packages \
         --python-version 3.12 --python-platform "${arch}-manylinux_2_28" --only-binary :all: \
         -r requirements.txt

FROM build-base AS test
ARG BUILDARCH
ARG UV_OFFLINE=false
COPY requirements.txt requirements-dev.txt ./
RUN --mount=type=secret,id=index_url,env=UV_DEFAULT_INDEX \
    --mount=type=cache,id=uv-${BUILDARCH},target=/root/.cache/uv,sharing=locked \
    uv pip install --system -r requirements-dev.txt
COPY worker ./worker
COPY tests ./tests
RUN ruff check --no-cache worker tests && python -m pytest -q -p no:cacheprovider && touch /tmp/.tests-passed

FROM build-base AS users
RUN --mount=type=bind,from=test,source=/tmp/.tests-passed,target=/tmp/.tests-passed \
    groupadd --system --gid 10001 worker \
    && useradd --system --uid 10001 --gid worker --no-create-home --shell /usr/sbin/nologin worker

FROM ${PYTHON_IMAGE} AS runtime
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG SOURCE_URL=https://git.shop-sas.example/platform/shop-worker
LABEL org.opencontainers.image.title="shop-worker" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="${SOURCE_URL}"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY --from=users /etc/passwd /etc/group /etc/
COPY --from=builder /opt/venv /opt/venv
COPY worker ./worker
USER 10001:10001
EXPOSE 9100
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --start-interval=1s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/metrics', timeout=2)"]
CMD ["python", "-m", "worker.main"]
